"""
ROCOS 机器人状态查询组件组 — Tool 模式。

每个组件输出 langchain_core.tools.Tool 对象，供 LLM Agent 直接调用。
工具执行后返回字符串观察值 (Observation)，大模型基于观察值继续推理。
"""

from langflow.custom import Component
from langflow.io import Output, StrInput
from langflow.schema import Data
from langchain_core.tools import Tool
import json as _json
import urllib.error as _urlerror
import urllib.parse as _urlparse
import urllib.request as _urlreq
from typing import Optional as _Optional


def _rocos_get(_base, _path, _params: _Optional[dict] = None):
    _url = f"{_base.rstrip('/')}{_path}"
    if _params:
        _q = "&".join(f"{k}={v}" for k, v in _params.items() if v is not None)
        _url = f"{_url}?{_q}"
    try:
        _req = _urlreq.Request(_url, headers={"Accept": "application/json"})
        with _urlreq.urlopen(_req, timeout=10) as _r:
            return _json.loads(_r.read().decode("utf-8"))
    except _urlerror.URLError as _e:
        return {"success": False, "code": -1, "message": f"网络错误: {_e}", "data": None}
    except _json.JSONDecodeError as _e:
        return {"success": False, "code": -2, "message": f"JSON解析错误: {_e}", "data": None}


def _rocos_post(_base, _path, _body: dict):
    _url = f"{_base.rstrip('/')}{_path}"
    try:
        _data = _json.dumps(_body).encode("utf-8")
        _req = _urlreq.Request(_url, data=_data, headers={"Content-Type": "application/json", "Accept": "application/json"}, method="POST")
        with _urlreq.urlopen(_req, timeout=30) as _r:
            return _json.loads(_r.read().decode("utf-8"))
    except _urlerror.URLError as _e:
        return {"success": False, "code": -1, "message": f"网络错误: {_e}", "data": None}
    except _json.JSONDecodeError as _e:
        return {"success": False, "code": -2, "message": f"JSON解析错误: {_e}", "data": None}


def _rocos_delete(_base, _path, _params: _Optional[dict] = None):
    _url = f"{_base.rstrip('/')}{_path}"
    if _params:
        _q = "&".join(f"{k}={v}" for k, v in _params.items() if v is not None)
        _url = f"{_url}?{_q}"
    try:
        _req = _urlreq.Request(_url, headers={"Accept": "application/json"}, method="DELETE")
        with _urlreq.urlopen(_req, timeout=10) as _r:
            return _json.loads(_r.read().decode("utf-8"))
    except _urlerror.URLError as _e:
        return {"success": False, "code": -1, "message": f"网络错误: {_e}", "data": None}
    except _json.JSONDecodeError as _e:
        return {"success": False, "code": -2, "message": f"JSON解析错误: {_e}", "data": None}


def _rocos_text(_base, _path, _params: _Optional[dict] = None):
    _url = f"{_base.rstrip('/')}{_path}"
    if _params:
        _q = "&".join(f"{k}={v}" for k, v in _params.items() if v is not None)
        _url = f"{_url}?{_q}"
    _req = _urlreq.Request(_url, headers={"Accept": "*/*"})
    with _urlreq.urlopen(_req, timeout=10) as _r:
        return _r.read().decode("utf-8")


def parse_float_list(_text: str, _expected_len: _Optional[int] = None):
    _vals = [float(x.strip()) for x in _text.split(",") if x.strip()]
    if _expected_len is not None and len(_vals) != _expected_len:
        raise ValueError(f"expected {_expected_len} values, got {len(_vals)}")
    return _vals


# ---- 状态查询组件 (Tool 模式) ----

class GetRobotState(Component):
    """获取机器人完整状态快照，供 LLM Agent 作为 Tool 调用"""

    display_name: str = "获取机器人状态"
    description: str = (
        "获取 ROCOS 机器人的完整状态快照，包括 FSM 状态、各关节位置/速度/力矩、"
        "法兰位姿 (flange)、当前工具坐标系和工件坐标系位姿、以及硬件总线状态。"
        "Use this tool when you need to know the robot's current state, joint positions, or end-effector pose."
    )
    icon: str = "Activity"
    name: str = "get_robot_state"

    inputs = [
        StrInput(
            name="base_url",
            display_name="API 基础地址",
            info="ROCOS API 的基础 URL",
            value="http://localhost:8080",
        ),
    ]

    outputs = [
        Output(display_name="Tool", name="component_as_tool",
               method="to_tool", types=["Tool"], tool_mode=True),
    ]

    def fetch_state(self) -> Data:
        """内部实现 — 调用 HTTP API 并返回 Data"""
        result = _rocos_get(self.base_url, "/api/robot/state")
        if result.get("success"):
            data = result.get("data", {})
            state = data.get("robot_state", "UNKNOWN")
            joints = data.get("joint_states", [])
            joint_summary = ", ".join(f"{j['name']}={j['position']:.3f}" for j in joints[:3])
            flange = data.get("flange", {})
            pos = flange.get("position", {})
            text = (
                f"机器人状态: {state}\n"
                f"使能: {data.get('is_enabled', False)}, 运动: {data.get('motion_busy', False)}\n"
                f"关节角度 (前3轴): {joint_summary}\n"
                f"法兰位置: x={pos.get('x',0):.3f}, y={pos.get('y',0):.3f}, z={pos.get('z',0):.3f}"
            )
        else:
            text = f"❌ {result.get('message', '查询失败')}"
        self.status = text[:100]
        return Data(text=text, data=result)

    def to_tool(self) -> Tool:
        """返回 LangChain Tool 对象，供 Agent 调用"""
        base = self.base_url

        def _run(_input: str = "") -> str:
            """Agent 调用此函数，返回观察值字符串"""
            result = _rocos_get(base, "/api/robot/state")
            if not result.get("success"):
                return f"查询失败: {result.get('message', '未知错误')}"
            d = result.get("data", {})
            joints = d.get("joint_states", [])
            lines = [f"机器人状态: {d.get('robot_state', '?')}"]
            lines.append(f"使能: {d.get('is_enabled', False)}, 运动中: {d.get('motion_busy', False)}")
            lines.append("关节角度 (rad):")
            for j in joints:
                lines.append(f"  {j['name']}: pos={j['position']:.4f} vel={j['velocity']:.2f} torque={j['torque']:.1f}")
            p = d.get("flange", {}).get("position", {})
            lines.append(f"法兰位置: x={p.get('x',0):.4f} y={p.get('y',0):.4f} z={p.get('z',0):.4f}")
            return "\n".join(lines)

        return Tool(
            name="GetRobotState",
            description="查询机器人当前完整状态: FSM状态、7个关节角度/速度/力矩、法兰位姿xyz、使能状态、运动中标志",
            func=_run,
        )


class GetRobotInfo(Component):
    """获取机器人关节参数信息，供 LLM Agent 作为 Tool 调用"""

    display_name: str = "获取机器人信息"
    description: str = (
        "获取 ROCOS 机器人的关节参数信息，包括各关节的传动比 (ratio)、"
        "每单位编码器计数 (cnt_per_unit)、单位名称 (unit_name) 等配置参数。"
        "Use this when you need to know joint configuration details like ratios and encoder counts."
    )
    icon: str = "Info"
    name: str = "get_robot_info"

    inputs = [
        StrInput(name="base_url", display_name="API 基础地址",
                 value="http://localhost:8080"),
    ]

    outputs = [
        Output(display_name="Tool", name="component_as_tool",
               method="to_tool", types=["Tool"], tool_mode=True),
    ]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_input: str = "") -> str:
            r = _rocos_get(base, "/api/robot/info")
            if not r.get("success"): return f"查询失败: {r.get('message')}"
            infos = r.get("data", {}).get("joint_infos", [])
            return "\n".join(f"[{j['id']}] {j['name']}: ratio={j['ratio']}, cnt/unit={j['cnt_per_unit']}, unit={j['unit_name']}" for j in infos)
        return Tool(
            name="GetRobotInfo",
            description="查询机器人关节配置参数: 传动比ratio、编码器计数cnt_per_unit、单位名称",
            func=_run,
        )


class GetRobotEnabled(Component):
    """查询机器人使能状态，供 LLM Agent 作为 Tool 调用"""

    display_name: str = "查询使能状态"
    description: str = (
        "查询 ROCOS 机器人当前是否已使能 (enabled)。"
        "Use this before issuing motion commands to verify the robot is ready."
    )
    icon: str = "Power"
    name: str = "get_robot_enabled"

    inputs = [
        StrInput(name="base_url", display_name="API 基础地址",
                 value="http://localhost:8080"),
    ]

    outputs = [
        Output(display_name="Tool", name="component_as_tool",
               method="to_tool", types=["Tool"], tool_mode=True),
    ]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_input: str = "") -> str:
            r = _rocos_get(base, "/api/robot/enabled")
            if not r.get("success"): return f"查询失败: {r.get('message')}"
            d = r.get("data", {})
            return f"使能: {'是' if d.get('enabled') else '否'}, FSM状态: {d.get('robot_state', '?')}"
        return Tool(
            name="GetRobotEnabled",
            description="查询机器人使能状态和FSM状态。运动前必须调用此工具确认 STOPPED+enabled",
            func=_run,
        )


class GetRobotURDF(Component):
    """获取机器人 URDF 模型 XML"""

    display_name: str = "获取 URDF 模型"
    description: str = (
        "获取 ROCOS 机器人的 URDF 模型 XML。Use this when you need the robot's kinematic tree."
    )
    icon: str = "FileText"
    name: str = "get_robot_urdf"

    inputs = [
        StrInput(name="base_url", display_name="API 基础地址",
                 value="http://localhost:8080"),
    ]

    outputs = [
        Output(display_name="Tool", name="component_as_tool",
               method="to_tool", types=["Tool"], tool_mode=True),
    ]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_input: str = "") -> str:
            r = _rocos_get(base, "/api/robot/urdf")
            if isinstance(r, dict) and not r.get("success", True):
                return f"获取失败: {r.get('message')}"
            return str(r)[:3000]
        return Tool(
            name="GetRobotURDF",
            description="获取机器人URDF模型XML，包含运动学链和连杆信息",
            func=_run,
        )
