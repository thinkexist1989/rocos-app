"""ROCOS 坐标系管理 — Tool 模式。12个工具/工件坐标系组件"""
from langflow.custom import Component
from langflow.io import Output, StrInput
from langchain_core.tools import Tool
import json as _json
import urllib.request as _urlreq

def _get(b,p,pa=None):
    u=f"{b.rstrip('/')}{p}"
    if pa: u+="?"+"&".join(f"{k}={v}" for k,v in pa.items() if v is not None)
    with _urlreq.urlopen(_urlreq.Request(u,headers={"Accept":"application/json"}),timeout=10) as r:
        return _json.loads(r.read().decode("utf-8"))
def _post(b,p,d):
    bd=_json.dumps(d).encode()
    with _urlreq.urlopen(_urlreq.Request(f"{b.rstrip('/')}{p}",data=bd,headers={"Content-Type":"application/json","Accept":"application/json"},method="POST"),timeout=30) as r:
        return _json.loads(r.read().decode("utf-8"))
def _del(b,p,pa=None):
    u=f"{b.rstrip('/')}{p}"
    if pa: u+="?"+"&".join(f"{k}={v}" for k,v in pa.items() if v is not None)
    with _urlreq.urlopen(_urlreq.Request(u,headers={"Accept":"application/json"},method="DELETE"),timeout=10) as r:
        return _json.loads(r.read().decode("utf-8"))

BASE_INPUT = [StrInput(name="base_url", value="http://localhost:8080")]
FRAME_INPUT = lambda: [StrInput(name="base_url", value="http://localhost:8080"), StrInput(name="name", display_name="坐标系名称", value="default")]
POSE_INPUT = lambda: [StrInput(name="base_url", value="http://localhost:8080"), StrInput(name="name", value="default"), StrInput(name="pos_x", value="0"), StrInput(name="pos_y", value="0"), StrInput(name="pos_z", value="0"), StrInput(name="ori_x", value="0"), StrInput(name="ori_y", value="0"), StrInput(name="ori_z", value="0"), StrInput(name="ori_w", value="1")]
PATH_INPUT = lambda: [StrInput(name="base_url", value="http://localhost:8080"), StrInput(name="path", display_name="YAML文件路径", value="frames.yaml")]

TOOL_OUT = lambda m: [Output(display_name="Tool", name="component_as_tool", method=m, types=["Tool"], tool_mode=True)]

# Tool Frame
class GetToolFrames(Component):
    display_name="获取工具坐标系列表"; description="列出所有工具坐标系名称"; icon="List"; name="get_tool_frames"; inputs=BASE_INPUT; outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b=self.base_url
        return Tool(name="GetToolFrames",description="列出所有工具坐标系名称和当前激活的",func=lambda _s="": str(_get(b,"/api/robot/tool_frames").get("data",{}).get("names",[])))

class GetToolFrame(Component):
    display_name="获取工具坐标系"; description="按名称获取工具坐标系位姿"; icon="Crosshair"; name="get_tool_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        return Tool(name="GetToolFrame",description=f"获取'{n}'工具坐标系的位姿",func=lambda _s="": str(_get(b,"/api/robot/tool_frame",{"name":n}).get("data",{})))

class SetToolFrame(Component):
    display_name="设置工具坐标系"; description="新增/修改工具坐标系位姿"; icon="Edit"; name="set_tool_frame"; inputs=POSE_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        p={"x":float(self.pos_x),"y":float(self.pos_y),"z":float(self.pos_z)}
        o={"x":float(self.ori_x),"y":float(self.ori_y),"z":float(self.ori_z),"w":float(self.ori_w)}
        def _run(s=""):
            r=_post(b,"/api/robot/tool_frame",{"name":n,"frame":{"position":p,"orientation":o}})
            return f"OK set {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="SetToolFrame",description=f"设置工具坐标系'{n}'",func=_run)

class ActivateToolFrame(Component):
    display_name="激活工具坐标系"; description="激活指定工具坐标系"; icon="CheckSquare"; name="activate_tool_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        def _run(_s=""): r=_post(b,"/api/robot/active_tool_frame",{"name":n}); return f"OK activated {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="ActivateToolFrame",description=f"激活工具坐标系'{n}'",func=_run)

class RemoveToolFrame(Component):
    display_name="删除工具坐标系"; description="删除指定工具坐标系"; icon="Trash"; name="remove_tool_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        def _run(_s=""): r=_del(b,"/api/robot/tool_frame",{"name":n}); return f"OK removed {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="RemoveToolFrame",description=f"删除工具坐标系'{n}'",func=_run)

# Object Frame (same pattern)
class GetObjectFrames(Component):
    display_name="获取工件坐标系列表"; description="列出所有工件坐标系"; icon="List"; name="get_object_frames"; inputs=BASE_INPUT; outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b=self.base_url
        return Tool(name="GetObjectFrames",description="列出所有工件坐标系名称",func=lambda _s="": str(_get(b,"/api/robot/object_frames").get("data",{}).get("names",[])))

class GetObjectFrame(Component):
    display_name="获取工件坐标系"; description="按名称获取工件坐标系位姿"; icon="Box"; name="get_object_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        return Tool(name="GetObjectFrame",description=f"获取'{n}'工件坐标系",func=lambda _s="": str(_get(b,"/api/robot/object_frame",{"name":n}).get("data",{})))

class SetObjectFrame(Component):
    display_name="设置工件坐标系"; description="新增/修改工件坐标系"; icon="Edit"; name="set_object_frame"; inputs=POSE_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name; p={"x":float(self.pos_x),"y":float(self.pos_y),"z":float(self.pos_z)}; o={"x":float(self.ori_x),"y":float(self.ori_y),"z":float(self.ori_z),"w":float(self.ori_w)}
        def _run(s=""): r=_post(b,"/api/robot/object_frame",{"name":n,"frame":{"position":p,"orientation":o}}); return f"OK set {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="SetObjectFrame",description=f"设置工件坐标系'{n}'",func=_run)

class ActivateObjectFrame(Component):
    display_name="激活工件坐标系"; description="激活指定工件坐标系"; icon="CheckSquare"; name="activate_object_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        def _run(_s=""): r=_post(b,"/api/robot/active_object_frame",{"name":n}); return f"OK activated {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="ActivateObjectFrame",description=f"激活工件坐标系'{n}'",func=_run)

class RemoveObjectFrame(Component):
    display_name="删除工件坐标系"; description="删除指定工件坐标系"; icon="Trash"; name="remove_object_frame"; inputs=FRAME_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,n=self.base_url,self.name
        def _run(_s=""): r=_del(b,"/api/robot/object_frame",{"name":n}); return f"OK removed {n}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="RemoveObjectFrame",description=f"删除工件坐标系'{n}'",func=_run)

class LoadFrames(Component):
    display_name="加载坐标系"; description="从YAML文件加载坐标系"; icon="Upload"; name="load_frames"; inputs=PATH_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,p=self.base_url,self.path
        def _run(_s=""): r=_post(b,"/api/robot/frames/load",{"path":p}); return f"OK loaded {p}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="LoadFrames",description=f"从YAML文件'{p}'加载坐标系",func=_run)

class SaveFrames(Component):
    display_name="保存坐标系"; description="保存坐标系到YAML文件"; icon="Download"; name="save_frames"; inputs=PATH_INPUT(); outputs=TOOL_OUT("to_tool")
    def to_tool(self)->Tool:
        b,p=self.base_url,self.path
        def _run(_s=""): r=_post(b,"/api/robot/frames/save",{"path":p}); return f"OK saved to {p}" if r.get("success") else f"FAIL: {r.get('message')}"
        return Tool(name="SaveFrames",description=f"保存坐标系到YAML文件'{p}'",func=_run)
