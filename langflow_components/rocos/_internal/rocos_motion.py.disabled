class MotionResume(Component):
    display_name: str = "继续运动"
    description: str = "继续暂停的运动。Use this to resume."
    icon: str = "PlayCircle"; name: str = "motion_resume"
    inputs = [StrInput(name="base_url", value="http://localhost:8080")]
    outputs = [Output(display_name="Tool", name="component_as_tool", method="to_tool", types=["Tool"], tool_mode=True)]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_s: str = "") -> str:
            r = _rocos_post(base, "/api/robot/resume", {})
            return "OK resumed" if r.get("success") else f"Resume FAIL: {r.get('message')}"
        return Tool(name="MotionResume", description="继续之前暂停的运动", func=_run)


class GetMotionStatus(Component):
    display_name: str = "查询运动状态"
    description: str = "查询运动状态和FSM。Use this to check motion progress."
    icon: str = "BarChart2"; name: str = "get_motion_status"
    inputs = [StrInput(name="base_url", value="http://localhost:8080")]
    outputs = [Output(display_name="Tool", name="component_as_tool", method="to_tool", types=["Tool"], tool_mode=True)]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_s: str = "") -> str:
            r = _rocos_get(base, "/api/robot/move_status")
            if r.get("success"):
                d = r.get("data", {})
                return f"state={d.get('robot_state','?')} running={d.get('is_running',False)} control_active={d.get('control_active',False)}"
            return f"查询失败: {r.get('message')}"
        return Tool(name="GetMotionStatus", description="查询机器人运动状态: FSM状态、是否运行中、控制是否活跃", func=_run)


class WaitMove(Component):
    display_name: str = "等待运动完成"
    description: str = "阻塞等待当前运动完成。Use this after issuing a motion command."
    icon: str = "Clock"; name: str = "wait_move"
    inputs = [StrInput(name="base_url", value="http://localhost:8080")]
    outputs = [Output(display_name="Tool", name="component_as_tool", method="to_tool", types=["Tool"], tool_mode=True)]

    def to_tool(self) -> Tool:
        base = self.base_url
        def _run(_s: str = "") -> str:
            r = _rocos_post(base, "/api/robot/wait_move", {})
            if r.get("success"):
                d = r.get("data", {})
                return f"Motion done: state={d.get('robot_state','?')} busy={d.get('motion_busy',False)}"
            return f"Wait FAIL: {r.get('message')}"
        return Tool(name="WaitMove", description="阻塞等待当前运动完成。运动指令后调用此工具确认完成", func=_run)
